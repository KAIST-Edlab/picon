# Lightweight image for the EdLab demo server (Kinstower).
# PICon's frontend is hosted on GitHub Pages, so this container only runs the
# lab-standard proxy (api/proxy.py) plus the autossh tunnel to the Daejeon 26 backend.
FROM python:3.11-slim

WORKDIR /workspace/picon_web

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    vim \
    curl \
    openssh-client \
    autossh \
    lsof \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_proxy.txt .
RUN pip install --no-cache-dir -r requirements_proxy.txt
RUN rm requirements_proxy.txt
