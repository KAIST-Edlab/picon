# Bridge URL (set to your Railway public URL in production)
BRIDGE_BASE_URL=http://localhost:8000

# LLM API keys (used by picon internally for questioner, evaluator, etc.)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External tools (used by picon for fact-checking)
SERPER_API_KEY=
GOOGLE_GEOCODE=
GOOGLE_CLAIM_SEARCH=
GOOGLE_CX_ID=

# LLM gateway (Letsur). When set, all server-side LLM calls (questioner,
# extractor, web search, evaluator, seed question) go through the gateway with
# this key; OPENAI_API_KEY(S) and GEMINI_API_KEY are then not used by the server.
LETSUR_API_KEY=
LETSUR_API_BASE=https://gw.letsur.ai/v1
