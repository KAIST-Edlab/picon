# Bridge URL (set to your Railway public URL in production)
BRIDGE_BASE_URL=http://localhost:8000

# LLM API keys (used by picon internally for questioner, evaluator, etc.)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External tools (used by picon for fact-checking)
SERPER_API_KEY=
GOOGLE_GEOCODE=
GOOGLE_CLAIM_SEARCH=
GOOGLE_CX_ID=

# LLM gateway (Letsur). When set, all server-side LLM calls (questioner,
# extractor, web search, evaluator, seed question) go through the gateway with
# this key; OPENAI_API_KEY(S) and GEMINI_API_KEY are then not used by the server.
LETSUR_API_KEY=
LETSUR_API_BASE=https://gw.letsur.ai/v1

# Human study archive. When set, sessions started from the study pages
# (/demo/neutral/, /demo/privacy-preserving/) are written here as JSON.
HUMAN_STUDY_DIR=

# --- Human study configuration (enterprise endpoints only) ---
# Azure OpenAI for picon's questioner / extractor / web-search / seed-question agents.
# Mapped to AZURE_* inside the worker AFTER user-supplied env, so users cannot override them.
PICON_AZURE_API_KEY=
PICON_AZURE_API_BASE=https://<resource>.openai.azure.com/
PICON_AZURE_API_VERSION=2025-04-01-preview
PICON_QUESTIONER_MODEL=azure/gpt-5
PICON_EXTRACTOR_MODEL=azure/gpt-5.1
PICON_WEB_SEARCH_MODEL=azure/gpt-5
PICON_SEED_QUESTION_MODEL=azure/gpt-5
# Vertex AI for the evaluator. VERTEXAI_CREDENTIALS is the JSON of a service account
# or an authorized_user credential (single line, single-quoted); the server writes it to a
# private file and exposes it to picon via GOOGLE_APPLICATION_CREDENTIALS.
PICON_EVALUATOR_MODEL=vertex_ai/gemini-2.5-flash
VERTEXAI_CREDENTIALS=''
VERTEXAI_PROJECT=
VERTEXAI_REGION=global
